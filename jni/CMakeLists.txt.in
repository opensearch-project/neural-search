cmake_minimum_required(VERSION 3.17)
project(googletest-download NONE)

include(ExternalProject)
ExternalProject_Add(googletest
        GIT_REPOSITORY https://github.com/google/googletest.git
        # Pinned to an immutable commit on purpose. Tracking `main` made every
        # fresh configure pull whatever googletest had just landed, so an upstream
        # breaking change would fail this build with no local change. A release
        # tag fixed that but tags can be force-pushed, and this fetch happens
        # automatically at configure time with no checksum to catch it.
        # b514bdc is release v1.15.2.
        #
        # GIT_SHALLOW is deliberately not set: CMake cannot shallow-clone an
        # arbitrary commit, only a named ref.
        GIT_TAG b514bdc898e2951020cbdca1304b75f5950d1f59
        SOURCE_DIR "${CMAKE_BINARY_DIR}/googletest-src"
        BINARY_DIR "${CMAKE_BINARY_DIR}/googletest-build"
        CONFIGURE_COMMAND ""
        BUILD_COMMAND ""
        INSTALL_COMMAND ""
        TEST_COMMAND ""
        )
